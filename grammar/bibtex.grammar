@top File { entry* }

entry {
  StringEntry |
  PreambleEntry |
  CommentEntry |
  Entry
}

StringEntry {
  @specialize<EntryType, "@string"> EntryOpen StringName "=" Value EntryClose
}

PreambleEntry {
  @specialize<EntryType, "@preamble"> EntryOpen Value EntryClose
}

CommentEntry {
  @specialize<EntryType, "@comment"> commentBlock
}

@skip {} {
  commentBlock { "{" commentContent* "}" }
  commentContent { BracedValue | Escape | commentText }
  BracedValue { "{" bracedContent* "}" }
  QuotedValue { "\"" quotedContent* "\"" }
}

Entry {
  EntryType EntryOpen EntryKey ("," Field)* ","? EntryClose
}

EntryOpen { "{" | "(" }
EntryClose { "}" | ")" }

Field {
  FieldName "=" Value
}

Value {
  ValueAtom (Concat ValueAtom)*
}

ValueAtom {
  BracedValue |
  QuotedValue |
  Number |
  StringRef
}

bracedContent { BracedValue | Escape | bracedText }
quotedContent { BracedValue | Escape | quotedText }

EntryKey  { keyIdentifier }
FieldName { nameIdentifier }
StringName { nameIdentifier }
StringRef  { nameIdentifier }

@tokens {
  EntryType { "@" $[a-zA-Z]+ }

  nameIdentifier { $[a-zA-Z_] $[a-zA-Z0-9_-]* }
  keyIdentifier  { $[a-zA-Z_] $[a-zA-Z0-9_:./-]* }

  Number { $[0-9]+ }
  Concat { "#" }

  Escape { "\\" _ }

  bracedText  { ![{}\\]+ }
  quotedText  { !["{}\\]+ }
  commentText { ![{}\\]+ }

  LineComment { "%" ![\n]* }
  whitespace  { $[ \t\r\n]+ }

  @precedence { Escape, bracedText, quotedText, commentText }
}

@skip { whitespace | LineComment }